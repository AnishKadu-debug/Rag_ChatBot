# ==============================================================================
# Configuration Template for WhatsApp Land Records RAG Chatbot
# Copy this file to .env and fill in the values: cp .env.example .env
# ==============================================================================

# Security & API Authentication
API_KEY=change-me
ALLOWED_ORIGINS=http://localhost:3000,https://example.com

# LLM Provider Configuration (openrouter | grok | groq | gemini | openai | anthropic)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Grok (xAI)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1

# GroqCloud (OpenAI-compatible API; unrelated to xAI Grok)
# Confirm the model in your GroqCloud console: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# LLM Generation Limits & Reliability
# Max output tokens per LLM response (0 = use provider default)
LLM_MAX_TOKENS=1024
# Bounded retries for transient network failures (timeouts/connection errors only)
LLM_MAX_RETRIES=1

# Gemini (Google)
GEMINI_API_KEY=
# OpenAI
OPENAI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=

# Embedding & Vector Database Settings
EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHROMA_DIR=./data/chroma
DOCS_DB_PATH=./data/documents.sqlite3
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_DISTANCE_THRESHOLD=0.45

# Document Upload Limits (End-User / Standard)
MAX_UPLOAD_MB=10
MAX_PAGES=30

# Official Land Records PDF Ingestion & Active Document Configuration
# Leave OFFICIAL_DOCUMENT_ID blank to automatically use the active official document from registry
OFFICIAL_DOCUMENT_ID=
ADMIN_MAX_UPLOAD_MB=100
ADMIN_MAX_PAGES=1000

# OCR Configuration (Tesseract languages)
OCR_LANGS=mar+eng
