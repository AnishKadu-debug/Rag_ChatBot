# ==============================================================================
# Configuration Template for WhatsApp Land Records RAG Chatbot
# Copy this file to .env and fill in the values: cp .env.example .env
# ==============================================================================

# Security & API Authentication
API_KEY=change-me
ALLOWED_ORIGINS=http://localhost:3000,https://example.com

# LLM Provider Configuration (gemini | openai | anthropic)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding & Vector Database Settings
EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHROMA_DIR=./data/chroma
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_DISTANCE_THRESHOLD=0.45

# Document Upload Limits
MAX_UPLOAD_MB=10
MAX_PAGES=30

# OCR Configuration (Tesseract languages)
OCR_LANGS=mar+eng
